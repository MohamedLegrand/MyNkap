# Variables d'environnement
PROJECT_NAME="MyNkap Backend"
API_V1_STR="/api/v1"

# Configuration de la base de données (PostgreSQL)
DATABASE_URL="postgresql://postgres:123@localhost:5432/mynkap"
# Pour la production (Supabase) :
# DATABASE_URL="postgresql://postgres:[password]@db.[supabase-ref].supabase.co:5432/postgres"

# Configuration JWT
# Génération : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="remplacer-par-une-cle-secrete-generee-aleatoirement"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS="http://localhost:5173"

# Clés API des fournisseurs IA (module JARVIS, à venir)
GROQ_API_KEY="remplacer-par-une-cle-groq"
GEMINI_API_KEY="remplacer-par-une-cle-gemini"

# Clés HR-Skills Pay (paiement Mobile Money, module Plans/Abonnement)
# Utiliser les clés hrsk_pk_test_.../hrsk_sk_test_... en développement.
HRPAY_PUBLIC_KEY="remplacer-par-une-cle-hrpay"
HRPAY_SECRET_KEY="remplacer-par-une-cle-hrpay"

# Clé API Brevo (envoi d'e-mails transactionnels : mot de passe oublié...)
# Sans cette clé, les e-mails sont simplement affichés dans la console.
BREVO_API_KEY="remplacer-par-une-cle-brevo"
MAIL_FROM_EMAIL="no-reply@mynkap.com"
MAIL_FROM_NAME="MyNkap"
FRONTEND_URL="http://localhost:5173"
