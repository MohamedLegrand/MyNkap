# Variables d'environnement
PROJECT_NAME="MyNkap Backend"
API_V1_STR="/api/v1"

# "development" ou "production" — passer à "production" au déploiement
# désactive la documentation interactive publique (/docs, /redoc, schéma
# OpenAPI), voir main.py.
ENVIRONMENT="development"

# Configuration de la base de données (PostgreSQL)
DATABASE_URL="postgresql://postgres:123@localhost:5432/mynkap"
# Pour la production (Supabase) :
# DATABASE_URL="postgresql://postgres:[password]@db.[supabase-ref].supabase.co:5432/postgres"

# Configuration JWT
# Génération : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="remplacer-par-une-cle-secrete-generee-aleatoirement"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (origines autorisées, séparées par des virgules) — 5175 est le port
# fixe du frontend MyNkap (voir frontend/vite.config.ts).
CORS_ORIGINS="http://localhost:5175"

# Clés API des fournisseurs IA (module JARVIS, à venir)
GROQ_API_KEY="remplacer-par-une-cle-groq"
GEMINI_API_KEY="remplacer-par-une-cle-gemini"

# Clés HR-Skills Pay (paiement Mobile Money, module Plans/Abonnement)
# Utiliser les clés hrsk_pk_test_.../hrsk_sk_test_... en développement.
HRPAY_PUBLIC_KEY="remplacer-par-une-cle-hrpay"
HRPAY_SECRET_KEY="remplacer-par-une-cle-hrpay"

# Paiement par carte bancaire (E-NKAP via HR-Skills Pay) — mêmes clés
# HRPAY_* ci-dessus. HRPAY_SANDBOX=true ajoute le préfixe /sandbox aux
# routes carte (aucun appel réel à E-NKAP) : le mettre à false en prod.
HRPAY_CARD_BASE_URL="https://api.hrskills-pay.com"
HRPAY_SANDBOX=true
# Plancher de commission carte (3,5 %) — sert au « gross-up » : le client
# règle le montant voulu + les frais, le compte reçoit le montant voulu.
HRPAY_CARD_TAUX_COMMISSION=0.035
# Secret des webhooks carte — laisser vide tant que la confirmation se fait
# par polling (pas encore de webhook).
HRPAY_WEBHOOK_SECRET=""

# Clé API Brevo (envoi d'e-mails transactionnels : mot de passe oublié...)
# Sans cette clé, les e-mails sont simplement affichés dans la console.
BREVO_API_KEY="remplacer-par-une-cle-brevo"
MAIL_FROM_EMAIL="no-reply@mynkap.com"
MAIL_FROM_NAME="MyNkap"
FRONTEND_URL="http://localhost:5175"

# OAuth Google (Se connecter avec Google) — Google Cloud Console > Identifiants.
# GOOGLE_CLIENT_ID doit aussi être renseigné côté frontend (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID="remplacer-par-un-client-id-google"
GOOGLE_CLIENT_SECRET="remplacer-par-un-client-secret-google"
